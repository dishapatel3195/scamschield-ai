{
    "name": "scamshield-ai",
    "version": "1.0.0",
    "scripts": {
      "start:client": "cd client && npm start",
      "start:server": "cd server && nodemon src/index.ts",
      "start:ai": "cd ai-service && venv/bin/uvicorn main:app --reload",
      "start": "concurrently \"npm:start:client\" \"npm:start:server\" \"npm:start:ai\""
    },
    "devDependencies": {
      "concurrently": "^8.2.1"
    }
  }